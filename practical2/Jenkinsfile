
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        TF_VAR_region        = 'us-east-1'
        TF_VAR_ami_id        = 'ami-0b6d9d3d33ba97d99'
        TF_VAR_instance_type = 't3.micro'
        TF_VAR_key_name      = 'one-key'
        TF_VAR_my_ip         = '149.71.34.110/32'
        TF_VAR_subnet_id     = 'subnet-06629a8410d116cf2'
        TF_VAR_vpc_id        = 'vpc-0c4b8db8fbb200e08'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                sh '''
                    docker run --rm \
                    -v "$WORKSPACE/practical2:/app" \
                    -w /app \
                    node:18-alpine \
                    node --check server.js
                '''
            }
        }

        stage('Terraform Init & Plan') {
            agent {
                docker {
                    image 'hashicorp/terraform:1.16.5'
                    args '--entrypoint="" --network host'
                    reuseNode true
                }
            }
            steps {
                dir('practical2') {
                    sh '''
                        terraform init
                        terraform fmt -check
                        terraform validate
                        terraform plan -input=false -out=tfplan
                    '''
                }
            }
        }

        stage('Manual Approval') {
            steps {
                input message: 'Approve Deployment EC2 creation?'
            }
        }

        stage('Terraform Apply') {
            agent {
                docker {
                    image 'hashicorp/terraform:1.16.5'
                    args '--entrypoint="" --network host'
                    reuseNode true
                }
            }
            steps {
                dir('practical2') {
                    sh '''
                        terraform apply -input=false -auto-approve tfplan
                        terraform output -raw public_ip > deploy_ip.txt
                    '''
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    script {
                        env.IMAGE_NAME =
                            "${env.DOCKER_USER}/nodejs-stripe-app:${env.BUILD_NUMBER}"
                    }

                    dir('practical2') {
                        sh '''
                            set +x

                            echo "$DOCKER_PASS" | docker login \
                                -u "$DOCKER_USER" --password-stdin

                            docker build -t "$IMAGE_NAME" .
                            docker push "$IMAGE_NAME"

                            docker logout
                        '''
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    ),
                    string(
                        credentialsId: 'stripe-publishable-key',
                        variable: 'STRIPE_PUBLISHABLE_KEY'
                    ),
                    string(
                        credentialsId: 'stripe-secret-key',
                        variable: 'STRIPE_SECRET_KEY'
                    ),
                    sshUserPrivateKey(
                        credentialsId: 'deployment-ec2-key',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {
                    sh '''
                        set +x

                        DEPLOY_IP=$(cat practical2/deploy_ip.txt)

                        cat > .env.deploy <<EOF
DOMAIN=http://${DEPLOY_IP}:3000
PORT=3000
STATIC_DIR=./client
PUBLISHABLE_KEY=${STRIPE_PUBLISHABLE_KEY}
SECRET_KEY=${STRIPE_SECRET_KEY}
EOF

                        chmod 600 .env.deploy

                        ssh -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$DEPLOY_IP" \
                            "sudo apt-get update -y &&
                             sudo apt-get install -y docker.io &&
                             sudo systemctl enable --now docker"

                        scp -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            .env.deploy \
                            "$SSH_USER@$DEPLOY_IP:/home/$SSH_USER/.env"

                        printf '%s' "$DOCKER_PASS" |
                        ssh -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$DEPLOY_IP" \
                            "sudo docker login -u '$DOCKER_USER' --password-stdin"

                        ssh -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$DEPLOY_IP" \
                            "sudo docker pull '$IMAGE_NAME'"

                        ssh -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$DEPLOY_IP" \
                            "sudo docker rm -f nodejs-app || true"

                        ssh -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$DEPLOY_IP" \
                            "sudo docker run -d \
                             --name nodejs-app \
                             --restart unless-stopped \
                             -p 3000:3000 \
                             --env-file /home/$SSH_USER/.env \
                             '$IMAGE_NAME'"

                        ssh -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$DEPLOY_IP" \
                            "sudo docker ps"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Node.js application deployed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check Jenkins console output.'
        }

        always {
            sh 'rm -f .env.deploy'
        }
    }
}
